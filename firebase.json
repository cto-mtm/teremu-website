{
  "hosting": {
    "public": "firebase/www",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "headers": [
      { "source": "_nuxt/**",  "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] },
      { "source": "_fonts/**", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] },
      { "source": "images/**", "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400" }] },
      { "source": "videos/**", "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400" }] },
      { "source": "raw/**/*.md", "headers": [{ "key": "Content-Type", "value": "text/markdown; charset=utf-8" }] },
      { "source": "llms.txt", "headers": [{ "key": "Content-Type", "value": "text/plain; charset=utf-8" }] }
    ]
  },
  "functions": [
    { "source": "firebase/functions", "codebase": "default" }
  ]
}
